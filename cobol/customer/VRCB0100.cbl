       IDENTIFICATION DIVISION.
       PROGRAM-ID. VRCB0100.

      *****************************************************************
      * PROJECT      : Project Phoenix
      * CLIENT       : VRUT Bank
      * PROGRAM      : VRCB0100
      * TRANSACTION  : CUSTADD
      * DESCRIPTION  : Customer Maintenance
      *
      * PURPOSE
      * Create a new customer in Customer Master File.
      *****************************************************************

       ENVIRONMENT DIVISION.

       INPUT-OUTPUT SECTION.

       FILE-CONTROL.

           SELECT CUSTOMER-FILE
               ASSIGN TO "test-data/VRCUSTM.dat"
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS FD-CUSTOMER-ID
               FILE STATUS IS WS-FILE-STATUS.

       DATA DIVISION.

       FILE SECTION.

       FD CUSTOMER-FILE.

       COPY VRCP0101
           REPLACING
               CP-CUSTOMER-RECORD BY FD-CUSTOMER-RECORD
               CP-CUSTOMER-IDENTITY BY FD-CUSTOMER-IDENTITY
               CP-CUSTOMER-ID BY FD-CUSTOMER-ID
               CP-CUSTOMER-TYPE BY FD-CUSTOMER-TYPE
               CP-CUSTOMER-TITLE BY FD-CUSTOMER-TITLE
               CP-CUSTOMER-FIRST-NAME BY FD-CUSTOMER-FIRST-NAME
               CP-CUSTOMER-MIDDLE-NAME BY FD-CUSTOMER-MIDDLE-NAME
               CP-CUSTOMER-LAST-NAME BY FD-CUSTOMER-LAST-NAME
               CP-CUSTOMER-GENDER BY FD-CUSTOMER-GENDER
               CP-CUSTOMER-DATE-OF-BIRTH BY FD-CUSTOMER-DATE-OF-BIRTH
               CP-CUSTOMER-CONTACT BY FD-CUSTOMER-CONTACT
               CP-CUSTOMER-MOBILE-NUMBER BY FD-CUSTOMER-MOBILE-NUMBER
               CP-CUSTOMER-EMAIL-ID BY FD-CUSTOMER-EMAIL-ID
               CP-CUSTOMER-ADDRESS BY FD-CUSTOMER-ADDRESS
               CP-CUSTOMER-ADDRESS-LINE-1 BY FD-CUSTOMER-ADDRESS-LINE-1
               CP-CUSTOMER-ADDRESS-LINE-2 BY FD-CUSTOMER-ADDRESS-LINE-2
               CP-CUSTOMER-CITY BY FD-CUSTOMER-CITY
               CP-CUSTOMER-STATE BY FD-CUSTOMER-STATE
               CP-CUSTOMER-PINCODE BY FD-CUSTOMER-PINCODE
               CP-CUSTOMER-COUNTRY BY FD-CUSTOMER-COUNTRY
               CP-CUSTOMER-BANK BY FD-CUSTOMER-BANK
               CP-CUSTOMER-HOME-BRANCH BY FD-CUSTOMER-HOME-BRANCH
               CP-CUSTOMER-STATUS BY FD-CUSTOMER-STATUS
               CP-CUSTOMER-ACTIVE BY FD-CUSTOMER-ACTIVE
               CP-CUSTOMER-INACTIVE BY FD-CUSTOMER-INACTIVE
               CP-CUSTOMER-DORMANT BY FD-CUSTOMER-DORMANT
               CP-CUSTOMER-BLOCKED BY FD-CUSTOMER-BLOCKED
               CP-CUSTOMER-CLOSED BY FD-CUSTOMER-CLOSED
               CP-CUSTOMER-AUDIT BY FD-CUSTOMER-AUDIT
               CP-CUSTOMER-CREATED-DATE BY FD-CUSTOMER-CREATED-DATE
               CP-CUSTOMER-CREATED-BY BY FD-CUSTOMER-CREATED-BY
               CP-CUSTOMER-LAST-UPD-DATE BY FD-CUSTOMER-LAST-UPD-DATE
               CP-CUSTOMER-LAST-UPD-BY BY FD-CUSTOMER-LAST-UPD-BY.

       WORKING-STORAGE SECTION.

       01 WS-FILE-STATUS              PIC XX.

       01 WS-SEQUENCE-TYPE            PIC X(10).
       01 WS-GENERATED-NUMBER         PIC 9(10).
       01 WS-MESSAGE-CODE             PIC X(12).

       COPY VRCP9002.

       LINKAGE SECTION.

       COPY VRCP0101
           REPLACING
               CP-CUSTOMER-RECORD BY LK-CUSTOMER-RECORD
               CP-CUSTOMER-IDENTITY BY LK-CUSTOMER-IDENTITY
               CP-CUSTOMER-ID BY LK-CUSTOMER-ID
               CP-CUSTOMER-TYPE BY LK-CUSTOMER-TYPE
               CP-CUSTOMER-TITLE BY LK-CUSTOMER-TITLE
               CP-CUSTOMER-FIRST-NAME BY LK-CUSTOMER-FIRST-NAME
               CP-CUSTOMER-MIDDLE-NAME BY LK-CUSTOMER-MIDDLE-NAME
               CP-CUSTOMER-LAST-NAME BY LK-CUSTOMER-LAST-NAME
               CP-CUSTOMER-GENDER BY LK-CUSTOMER-GENDER
               CP-CUSTOMER-DATE-OF-BIRTH BY LK-CUSTOMER-DATE-OF-BIRTH
               CP-CUSTOMER-CONTACT BY LK-CUSTOMER-CONTACT
               CP-CUSTOMER-MOBILE-NUMBER BY LK-CUSTOMER-MOBILE-NUMBER
               CP-CUSTOMER-EMAIL-ID BY LK-CUSTOMER-EMAIL-ID
               CP-CUSTOMER-ADDRESS BY LK-CUSTOMER-ADDRESS
               CP-CUSTOMER-ADDRESS-LINE-1 BY LK-CUSTOMER-ADDRESS-LINE-1
               CP-CUSTOMER-ADDRESS-LINE-2 BY LK-CUSTOMER-ADDRESS-LINE-2
               CP-CUSTOMER-CITY BY LK-CUSTOMER-CITY
               CP-CUSTOMER-STATE BY LK-CUSTOMER-STATE
               CP-CUSTOMER-PINCODE BY LK-CUSTOMER-PINCODE
               CP-CUSTOMER-COUNTRY BY LK-CUSTOMER-COUNTRY
               CP-CUSTOMER-BANK BY LK-CUSTOMER-BANK
               CP-CUSTOMER-HOME-BRANCH BY LK-CUSTOMER-HOME-BRANCH
               CP-CUSTOMER-STATUS BY LK-CUSTOMER-STATUS
               CP-CUSTOMER-ACTIVE BY LK-CUSTOMER-ACTIVE
               CP-CUSTOMER-INACTIVE BY LK-CUSTOMER-INACTIVE
               CP-CUSTOMER-DORMANT BY LK-CUSTOMER-DORMANT
               CP-CUSTOMER-BLOCKED BY LK-CUSTOMER-BLOCKED
               CP-CUSTOMER-CLOSED BY LK-CUSTOMER-CLOSED
               CP-CUSTOMER-AUDIT BY LK-CUSTOMER-AUDIT
               CP-CUSTOMER-CREATED-DATE BY LK-CUSTOMER-CREATED-DATE
               CP-CUSTOMER-CREATED-BY BY LK-CUSTOMER-CREATED-BY
               CP-CUSTOMER-LAST-UPD-DATE BY LK-CUSTOMER-LAST-UPD-DATE
               CP-CUSTOMER-LAST-UPD-BY BY LK-CUSTOMER-LAST-UPD-BY.

       COPY VRCP9003
           REPLACING OPERATION-RESULT
           BY LK-OPERATION-RESULT.

       PROCEDURE DIVISION
           USING LK-CUSTOMER-RECORD
                 LK-OPERATION-RESULT.

       1000-MAIN.

           MOVE LK-CUSTOMER-RECORD
             TO FD-CUSTOMER-RECORD

           MOVE ZERO
             TO OPERATION-RETURN-CODE

           MOVE "S"
             TO OPERATION-SEVERITY

           MOVE SPACES
             TO OPERATION-ERROR-CODE
                OPERATION-RETURN-MESSAGE

           PERFORM 2000-INITIALIZE

           PERFORM 3000-VALIDATE-CUSTOMER

           IF VALIDATION-RETURN-CODE NOT = ZERO
               PERFORM 3500-SET-VALIDATION-ERROR
           ELSE
               MOVE 1
                 TO FD-CUSTOMER-ID IN FD-CUSTOMER-RECORD

               PERFORM 5000-CHECK-DUPLICATE

               IF OPERATION-RETURN-CODE = ZERO
                   PERFORM 4000-GENERATE-CUSTOMER-ID
                   PERFORM 6000-WRITE-CUSTOMER
               END-IF
           END-IF

           PERFORM 9000-TERMINATE

               MOVE FD-CUSTOMER-RECORD
                 TO LK-CUSTOMER-RECORD

           GOBACK.

       2000-INITIALIZE.

           MOVE "CUSTOMER"
             TO WS-SEQUENCE-TYPE

           OPEN I-O CUSTOMER-FILE.

       3000-VALIDATE-CUSTOMER.

           CALL "VRCB0110"
                USING FD-CUSTOMER-RECORD
                      VALIDATION-RESULT.

      * Customer ID Generation - Next Version
      * Duplicate Check        - Next Version
      * Customer Write         - Next Version
       
       3500-SET-VALIDATION-ERROR.

           MOVE "VR-CUST-999"
             TO WS-MESSAGE-CODE

           EVALUATE VALIDATION-RETURN-CODE
               WHEN 01
                   MOVE "VR-CUST-004"
                     TO WS-MESSAGE-CODE
               WHEN 02
                   MOVE "VR-CUST-004"
                     TO WS-MESSAGE-CODE
               WHEN 06
                   MOVE "VR-CUST-002"
                     TO WS-MESSAGE-CODE
           END-EVALUATE

           CALL "VRCB9005"
                USING WS-MESSAGE-CODE
                      LK-OPERATION-RESULT

           MOVE 01
             TO OPERATION-RETURN-CODE

           MOVE "E"
             TO OPERATION-SEVERITY.

       4000-GENERATE-CUSTOMER-ID.

           CALL "VRCB0120"
                USING WS-SEQUENCE-TYPE
                      WS-GENERATED-NUMBER

           MOVE WS-GENERATED-NUMBER
             TO FD-CUSTOMER-ID IN FD-CUSTOMER-RECORD.

       5000-CHECK-DUPLICATE.



           READ CUSTOMER-FILE
               INVALID KEY
                   CONTINUE

               NOT INVALID KEY

                   MOVE "VR-CUST-001"
                     TO WS-MESSAGE-CODE

                   CALL "VRCB9005"
                        USING WS-MESSAGE-CODE
                              LK-OPERATION-RESULT

                   MOVE 01
                     TO OPERATION-RETURN-CODE

                   MOVE "E"
                     TO OPERATION-SEVERITY
           END-READ.

       6000-WRITE-CUSTOMER.

           WRITE FD-CUSTOMER-RECORD
               INVALID KEY
                   MOVE "VR-CUST-002"
                     TO WS-MESSAGE-CODE

                   CALL "VRCB9005"
                        USING WS-MESSAGE-CODE
                              LK-OPERATION-RESULT

                   MOVE 01
                     TO OPERATION-RETURN-CODE

                   MOVE "E"
                     TO OPERATION-SEVERITY

               NOT INVALID KEY
                   MOVE ZERO
                     TO OPERATION-RETURN-CODE

                   MOVE "S"
                     TO OPERATION-SEVERITY

                   MOVE SPACES
                     TO OPERATION-ERROR-CODE
                        OPERATION-RETURN-MESSAGE
           END-WRITE.
           
       9000-TERMINATE.

           CLOSE CUSTOMER-FILE.
