       IDENTIFICATION DIVISION.
       PROGRAM-ID. VRCB0110.

      *****************************************************************
      * PROJECT      : Project Phoenix
      * CLIENT       : VRUT Bank
      * PROGRAM      : VRCB0110
      * DESCRIPTION  : Customer Validation
      *
      * PURPOSE
      * Validate customer information before persistence.
      *
      * INPUT
      *    CUSTOMER-RECORD
      *
      * OUTPUT
      *    VALIDATION-RESULT
      *
      * CALLED BY
      *    VRCB0100
      *****************************************************************

       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.

       COPY VRCP9001.

       LINKAGE SECTION.

       COPY VRCP0101
           REPLACING
               CP-CUSTOMER-RECORD BY LK-CUSTOMER-RECORD
               CP-CUSTOMER-IDENTITY BY LK-CUSTOMER-IDENTITY
               CP-CUSTOMER-ID BY LK-CUSTOMER-ID
               CP-CUSTOMER-TYPE BY LK-CUSTOMER-TYPE
               CP-CUSTOMER-TITLE BY LK-CUSTOMER-TITLE
               CP-CUSTOMER-FIRST-NAME BY LK-CUSTOMER-FIRST-NAME
               CP-CUSTOMER-MIDDLE-NAME BY LK-CUSTOMER-MIDDLE-NAME
               CP-CUSTOMER-LAST-NAME BY LK-CUSTOMER-LAST-NAME
               CP-CUSTOMER-GENDER BY LK-CUSTOMER-GENDER
               CP-CUSTOMER-DATE-OF-BIRTH BY LK-CUSTOMER-DATE-OF-BIRTH
               CP-CUSTOMER-CONTACT BY LK-CUSTOMER-CONTACT
               CP-CUSTOMER-MOBILE-NUMBER BY LK-CUSTOMER-MOBILE-NUMBER
               CP-CUSTOMER-EMAIL-ID BY LK-CUSTOMER-EMAIL-ID
               CP-CUSTOMER-ADDRESS BY LK-CUSTOMER-ADDRESS
               CP-CUSTOMER-ADDRESS-LINE-1 BY LK-CUSTOMER-ADDRESS-LINE-1
               CP-CUSTOMER-ADDRESS-LINE-2 BY LK-CUSTOMER-ADDRESS-LINE-2
               CP-CUSTOMER-CITY BY LK-CUSTOMER-CITY
               CP-CUSTOMER-STATE BY LK-CUSTOMER-STATE
               CP-CUSTOMER-PINCODE BY LK-CUSTOMER-PINCODE
               CP-CUSTOMER-COUNTRY BY LK-CUSTOMER-COUNTRY
               CP-CUSTOMER-BANK BY LK-CUSTOMER-BANK
               CP-CUSTOMER-HOME-BRANCH BY LK-CUSTOMER-HOME-BRANCH
               CP-CUSTOMER-STATUS BY LK-CUSTOMER-STATUS
               CP-CUSTOMER-ACTIVE BY LK-CUSTOMER-ACTIVE
               CP-CUSTOMER-INACTIVE BY LK-CUSTOMER-INACTIVE
               CP-CUSTOMER-DORMANT BY LK-CUSTOMER-DORMANT
               CP-CUSTOMER-BLOCKED BY LK-CUSTOMER-BLOCKED
               CP-CUSTOMER-CLOSED BY LK-CUSTOMER-CLOSED
               CP-CUSTOMER-AUDIT BY LK-CUSTOMER-AUDIT
               CP-CUSTOMER-CREATED-DATE BY LK-CUSTOMER-CREATED-DATE
               CP-CUSTOMER-CREATED-BY BY LK-CUSTOMER-CREATED-BY
               CP-CUSTOMER-LAST-UPD-DATE BY LK-CUSTOMER-LAST-UPD-DATE
               CP-CUSTOMER-LAST-UPD-BY BY LK-CUSTOMER-LAST-UPD-BY.

       COPY VRCP9002.

       PROCEDURE DIVISION
           USING
               LK-CUSTOMER-RECORD
               VALIDATION-RESULT.

       1000-MAIN.

           PERFORM 2000-INITIALIZE

           PERFORM 3000-VALIDATE-CUSTOMER

           GOBACK.

       2000-INITIALIZE.

           MOVE ZERO TO VALIDATION-RETURN-CODE.

       3000-VALIDATE-CUSTOMER.

           PERFORM 3100-VALIDATE-FIRST-NAME

           IF VALIDATION-RETURN-CODE NOT = ZERO
              EXIT PARAGRAPH
           END-IF

           PERFORM 3200-VALIDATE-LAST-NAME

           IF VALIDATION-RETURN-CODE NOT = ZERO
              EXIT PARAGRAPH
           END-IF

           PERFORM 3300-VALIDATE-CUSTOMER-TYPE

           IF VALIDATION-RETURN-CODE NOT = ZERO
              EXIT PARAGRAPH
           END-IF

           PERFORM 3400-VALIDATE-GENDER

           IF VALIDATION-RETURN-CODE NOT = ZERO
              EXIT PARAGRAPH
           END-IF

           PERFORM 3500-VALIDATE-STATUS

           IF VALIDATION-RETURN-CODE NOT = ZERO
              EXIT PARAGRAPH
           END-IF

           PERFORM 3600-VALIDATE-BRANCH.

       3100-VALIDATE-FIRST-NAME.

           IF LK-CUSTOMER-FIRST-NAME = SPACES
              MOVE 01 TO VALIDATION-RETURN-CODE
           END-IF.

       3200-VALIDATE-LAST-NAME.

           IF LK-CUSTOMER-LAST-NAME = SPACES
              MOVE 02 TO VALIDATION-RETURN-CODE
           END-IF.

       3300-VALIDATE-CUSTOMER-TYPE.

           IF LK-CUSTOMER-TYPE NOT = CUSTOMER-TYPE-INDIVIDUAL
              AND LK-CUSTOMER-TYPE NOT = CUSTOMER-TYPE-NRI
              AND LK-CUSTOMER-TYPE NOT = CUSTOMER-TYPE-CORPORATE
              MOVE 03 TO VALIDATION-RETURN-CODE
           END-IF.

       3400-VALIDATE-GENDER.

           IF LK-CUSTOMER-GENDER NOT = GENDER-MALE
              AND LK-CUSTOMER-GENDER NOT = GENDER-FEMALE
              AND LK-CUSTOMER-GENDER NOT = GENDER-OTHER
              MOVE 04 TO VALIDATION-RETURN-CODE
           END-IF.

       3500-VALIDATE-STATUS.

           IF LK-CUSTOMER-STATUS NOT = STATUS-ACTIVE
              AND LK-CUSTOMER-STATUS NOT = STATUS-INACTIVE
              AND LK-CUSTOMER-STATUS NOT = STATUS-DORMANT
              AND LK-CUSTOMER-STATUS NOT = STATUS-BLOCKED
              AND LK-CUSTOMER-STATUS NOT = STATUS-CLOSED
              MOVE 05 TO VALIDATION-RETURN-CODE
           END-IF.

       3600-VALIDATE-BRANCH.

           IF LK-CUSTOMER-HOME-BRANCH = SPACES
              MOVE 06 TO VALIDATION-RETURN-CODE
           END-IF.
